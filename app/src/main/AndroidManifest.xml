<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!--
      Só o necessário (§16).

      NÃO pedimos MEDIA_CONTENT_CONTROL: é permissão privilegiada, só
      concedida a app de sistema. O acesso às sessões de outros
      aplicativos vem do serviço de notificações que o usuário habilita à
      mão nos Ajustes — caminho oficial para app comum.
    -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MEDIA_PLAYBACK" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <!-- Só para mostrar QUAL fone está conectado na tela de diagnóstico.
         Do Android 12 em diante é permissão de tempo de execução, e o app
         funciona sem ela: fica sem o nome do dispositivo. -->
    <uses-permission android:name="android.permission.BLUETOOTH_CONNECT" />

    <!-- Restaurar o estado após reiniciar o aparelho (§18), e só isso. -->
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />

    <application
        android:name=".GuardApplication"
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.BluetoothMediaGuard">

        <activity
            android:name=".presentation.MainActivity"
            android:exported="true"
            android:label="@string/app_name"
            android:theme="@style/Theme.BluetoothMediaGuard">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!--
          O serviço que mantém nossa MediaSession viva.

          `mediaPlayback` porque é o tipo que o Android exige para um
          serviço que possui uma MediaSession — e não para disfarçar
          outra coisa.
        -->
        <service
            android:name=".service.GuardService"
            android:exported="false"
            android:foregroundServiceType="mediaPlayback" />

        <!--
          Acesso às sessões de outros apps.

          É por aqui que o app vê o Spotify pausar e consegue desfazer.
          O usuário habilita em Ajustes → Acesso a notificações; nunca
          é ligado por código (§16).
        -->
        <service
            android:name=".service.MediaGuardNotificationListener"
            android:exported="true"
            android:label="@string/app_name"
            android:permission="android.permission.BIND_NOTIFICATION_LISTENER_SERVICE">
            <intent-filter>
                <action android:name="android.service.notification.NotificationListenerService" />
            </intent-filter>
        </service>

        <!--
          Serviço de acessibilidade — SONDA DE DIAGNÓSTICO, não bloqueio.

          A pesquisa (docs/pesquisa-tecnica.md) mostrou que botão de mídia
          de fone Bluetooth não passa pelo despacho de teclas, então este
          serviço não os recebe. Fica porque é o que prova isso no
          aparelho da pessoa, e porque enxerga teclas físicas.
        -->
        <service
            android:name=".service.KeyProbeAccessibilityService"
            android:exported="true"
            android:label="@string/nome_sonda_acessibilidade"
            android:permission="android.permission.BIND_ACCESSIBILITY_SERVICE">
            <intent-filter>
                <action android:name="android.accessibilityservice.AccessibilityService" />
            </intent-filter>
            <meta-data
                android:name="android.accessibilityservice"
                android:resource="@xml/servico_acessibilidade" />
        </service>

        <receiver
            android:name=".service.BootReceiver"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
            </intent-filter>
        </receiver>

    </application>
</manifest>
