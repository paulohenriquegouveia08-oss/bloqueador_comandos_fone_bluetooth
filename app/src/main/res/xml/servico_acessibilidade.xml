<?xml version="1.0" encoding="utf-8"?>
<!--
  Sonda de teclas.

  `canRequestFilterKeyEvents` é o que permite ver (e consumir) eventos de
  tecla. Vale para teclas físicas do aparelho; botão de mídia de fone
  Bluetooth não chega aqui — ver docs/pesquisa-tecnica.md.

  `accessibilityEventTypes` fica em nenhum tipo de propósito: não
  queremos conteúdo de tela, só teclas. Pedir menos é o que permite
  explicar a permissão com honestidade.
-->
<accessibility-service xmlns:android="http://schemas.android.com/apk/res/android"
    android:accessibilityEventTypes="typeWindowStateChanged"
    android:accessibilityFeedbackType="feedbackGeneric"
    android:canRequestFilterKeyEvents="true"
    android:description="@string/descricao_sonda_acessibilidade"
    android:notificationTimeout="100" />
